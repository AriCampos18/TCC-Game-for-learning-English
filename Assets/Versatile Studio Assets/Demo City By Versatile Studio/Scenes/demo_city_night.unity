  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\rParab\xE9ns! Voc\xEA concluiu todas as miss\xF5es e chegou ao final
    do jogo.\r\nEsperamos que esta experi\xEAncia tenha ajudado voc\xEA a aprender
    novo vocabul\xE1rio, aprimorar suas habilidades de comunica\xE7\xE3o e ganhar
    mais confian\xE7a ao usar o ingl\xEAs em situa\xE7\xF5es do dia a dia.\r\nContinue
    praticando, continue aprendendo e lembre-se: cada pequeno passo te aproxima da
    flu\xEAncia!\r\nSe quiser jogar novamente e se desafiar mais uma vez, basta clicar
    no bot\xE3o abaixo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
